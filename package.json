{
  "name": "pierre-trees-svelte-suede",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "sweater-vest-suede/templates/sveltekit/with-exclude-tests-routes-from-build.sh vite build",
    "preview": "vite preview",
    "report": "sweater-vest-suede/report.sh --closet /tests",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "svelte-check": "^4.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "@storybook/test": "^8.6.14",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^25.6.0",
    "dockerode": "^5.0.0",
    "dockview-core": "^4.11.0",
    "dockview": "^4.11.0",
    "html-to-image": "^1.11.13",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@pierre/trees": "^1.0.0-beta.6",
    "svelte": "^5.43.5"
  }
}
